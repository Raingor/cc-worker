{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate manifest",
      "type": "shell",
      "command": "npx @microsoft/teamsapp-cli validate --manifest-path ./appPackage/declarativeAgent.json",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Package for sideloading",
      "type": "shell",
      "command": "npx @microsoft/teamsapp-cli package --manifest-path ./appPackage/declarativeAgent.json --output-zip-path ./build/cc-sales-assistant-agent.zip",
      "problemMatcher": [],
      "dependsOn": ["Validate manifest"]
    },
    {
      "label": "Preview in Copilot (sideload)",
      "type": "shell",
      "command": "npx @microsoft/teamsapp-cli preview --manifest-path ./appPackage/declarativeAgent.json --m365-host copilot",
      "problemMatcher": [],
      "dependsOn": ["Package for sideloading"]
    },
    {
      "label": "Build for production",
      "type": "shell",
      "command": "npx @microsoft/teamsapp-cli package --manifest-path ./appPackage/declarativeAgent.json --output-zip-path ./build/cc-sales-assistant-agent.zip --environment prod",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
