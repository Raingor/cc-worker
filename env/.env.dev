# Dev environment variables
# Replace these with actual values from your M365 tenant

# Azure AD App (auto-generated by 'provision' lifecycle)
AAD_APP_CLIENT_ID=
AAD_APP_OBJECT_ID=
AAD_APP_TENANT_ID=
AAD_APP_OAUTH_AUTHORITY=

# SharePoint Knowledge Sources
# Replace with actual SharePoint site URLs
CC_ONEDRIVE_URL={CC_OneDrive_Url}
SHAREPOINT_PRODUCTS_URL={SharePoint_Site_Url_Products}
SHAREPOINT_ORDERS_URL={SharePoint_Site_Url_Orders}
SHAREPOINT_CUSTOMERS_URL={SharePoint_Site_Url_Customers}
